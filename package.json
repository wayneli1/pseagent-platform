{
  "name": "pseagent-platform",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "workspaces": ["apps/pseagent", "services/knowledge-mcp", "integrations/lunkr-direct"],
  "scripts": {
    "build": "npm run build --workspaces --if-present && cargo build --manifest-path services/knowledge-engine/Cargo.toml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && cargo test --manifest-path services/knowledge-engine/Cargo.toml",
    "test:ts": "npm run test --workspaces --if-present",
    "test:rust": "cargo test --manifest-path services/knowledge-engine/Cargo.toml",
    "probe:live": "node --env-file=.env.local --import tsx scripts/probe-live.mts",
    "probe:coremail": "node --env-file=.env.local --import tsx scripts/probe-coremail-historical.mts",
    "probe:related-context": "node --env-file=.env.local --import tsx scripts/probe-related-context.mts",
    "probe:layered-evidence": "node --env-file=.env.local --import tsx scripts/probe-layered-evidence.mts",
    "probe:exchange-comparison": "node --env-file=.env.local --import tsx scripts/probe-exchange-comparison.mts",
    "probe:stability": "node --env-file=.env.local --import tsx scripts/probe-stability.mts",
    "test:regression": "npm exec -w @pseagent/app -- vitest run src/regression.test.ts",
    "lunkr:login": "node --import tsx scripts/lunkr-login.mts",
    "lunkr:status": "node --import tsx scripts/lunkr-status.mts",
    "lunkr:start": "node --env-file=.env.local --import tsx scripts/lunkr-start.mts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
