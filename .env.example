PSE_MODEL_BASE_URL=https://model.example.invalid/v1
PSE_MODEL_API_KEY=
PSE_MODEL_NAME=
# 四个角色默认继承 PSE_MODEL_NAME；只有同一网关需要按角色切换模型时才填写。
# PSE_RESOLVER_MODEL_NAME=
# PSE_PLANNER_MODEL_NAME=
# PSE_SYNTHESIZER_MODEL_NAME=
# PSE_VERIFIER_MODEL_NAME=
# 不支持 OpenAI response_format=json_object 的兼容网关设为 false；严格 Schema 校验不会关闭。
PSE_MODEL_JSON_RESPONSE_FORMAT=true
PSE_MODEL_TIMEOUT_MS=60000
# Recommended Lunkr deployment: 540s active < 570s request < 600s total.
PSE_REQUEST_TIMEOUT_MS=570000
PSE_ACTIVE_DEADLINE_MS=540000
KNOWLEDGE_PROJECTS_CONFIG=C:/Users/Coremail/Desktop/Coremail-PSE/pseagent-platform/config/knowledge-projects.local.json
KNOWLEDGE_INDEX_ROOT=C:/Users/Coremail/Desktop/Coremail-PSE/pseagent-platform/indexes
COREMAIL_PROFESSIONAL_REVISION=
PRESALES_GENERAL_REVISION=
PSE_DIAGNOSTICS_ENABLED=false
# PSE_DIAGNOSTICS_DIR=仅允许使用系统临时目录下的子目录
# TaskSpec 影子分析默认关闭；启用时只记录脱敏结构诊断，不改变正式回答。
PSE_TASK_SPEC_SHADOW_ENABLED=false
# 仅影子观测建议 15s；正式启用任务契约时建议 120s，以容纳一次结构修复。
PSE_TASK_SPEC_SHADOW_TIMEOUT_MS=120000
# TaskSpec 正式计划替换默认关闭；启用前必须同时启用上面的影子分析。
PSE_TASK_SPEC_ACTIVE_ENABLED=false
# 多知识域执行默认关闭；仅可在影子分析与 TaskSpec 正式计划均启用后开启。
PSE_MULTI_DOMAIN_ACTIVE_ENABLED=false
KNOWLEDGE_ENGINE_URL=http://127.0.0.1:19829
KNOWLEDGE_ENGINE_TOKEN=
KNOWLEDGE_ENGINE_TIMEOUT_MS=30000
KNOWLEDGE_MCP_COMMAND=node
KNOWLEDGE_MCP_ENTRY_PATH=C:/Users/Coremail/Desktop/Coremail-PSE/pseagent-platform/services/knowledge-mcp/dist/server.js
COREMAIL_MCP_ENABLED=false
COREMAIL_MCP_COMMAND=node
COREMAIL_MCP_ENTRY_PATH=C:/Users/Coremail/.local/share/coremail-knowledge-mcp/current/dist/server.js
COREMAIL_MCP_TIMEOUT_MS=30000
LUNKR_BASE_URL=https://lunkr.coremail.cn
LUNKR_API_PATH=/lunkr/s/json
LUNKR_SESSION_PATH=
LUNKR_CONNECT_TIMEOUT_MS=30000
LUNKR_RECONNECT_MAX_MS=30000
LUNKR_MESSAGE_DEDUPE_TTL_MS=600000
LUNKR_MESSAGE_DEDUPE_MAX=2000
LUNKR_CONTEXT_MAX_TURNS=6
LUNKR_CONTEXT_MAX_CHARS=12000
LUNKR_MESSAGE_MAX_CHARS=1000
LUNKR_QUESTION_BUDGET_MS=600000
LUNKR_MAX_ACTIVE_PEERS=4
LUNKR_MAX_PENDING_PER_PEER=5
LUNKR_SESSION_IDLE_MS=86400000
