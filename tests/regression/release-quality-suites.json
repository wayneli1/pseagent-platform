[
  {
    "suiteId": "professional_migration",
    "title": "专业库：迁移与备份边界",
    "cases": [
      {
        "id": "QG-PRO-CANONICAL",
        "kind": "canonical",
        "turn": 1,
        "question": "腾讯企业邮箱迁移到Coremail前需要哪些设置？",
        "expected": {
          "scopes": ["professional"],
          "statuses": ["answered", "partially_answered"],
          "minimumReferences": 1,
          "matchTypes": ["exact"],
          "requiredConcepts": [
            { "id": "credential", "anyOf": ["客户端专用密码", "安全登录"] },
            { "id": "protocol", "anyOf": ["IMAP", "SMTP"] }
          ],
          "forbiddenPatterns": ["普通登录密码一定可以直接用于迁移"]
        }
      },
      {
        "id": "QG-PRO-ALIAS",
        "kind": "alias",
        "turn": 2,
        "question": "Exchange迁移时密码能直接迁吗？",
        "expected": {
          "scopes": ["professional"],
          "statuses": ["answered", "partially_answered"],
          "minimumReferences": 1,
          "matchTypes": ["exact"],
          "requiredConcepts": [
            { "id": "auth", "anyOf": ["AD", "外部认证", "MigratePassword"] },
            { "id": "boundary", "anyOf": ["不能", "无法", "需确认", "取决于"] }
          ],
          "forbiddenPatterns": ["可以直接导出Exchange明文密码"]
        }
      },
      {
        "id": "QG-PRO-COLLOQUIAL",
        "kind": "colloquial",
        "turn": 3,
        "question": "客户邮箱数据量很大，备份到底选高级备份还是第三方软件？",
        "expected": {
          "scopes": ["professional"],
          "statuses": ["answered", "partially_answered"],
          "minimumReferences": 1,
          "requiredConcepts": [
            { "id": "options", "anyOf": ["高级备份", "第三方软件", "备份"] },
            { "id": "validation", "anyOf": ["兼容", "恢复", "确认", "验证"] }
          ],
          "forbiddenPatterns": ["高级备份适用于任意数据规模"]
        }
      },
      {
        "id": "QG-PRO-FOLLOWUP",
        "kind": "follow_up",
        "turn": 4,
        "question": "那除了邮件正文，日程、通讯录和个人规则是不是也默认全迁？",
        "consistencyKey": "personal-config-boundary",
        "expected": {
          "scopes": ["professional"],
          "statuses": ["answered", "partially_answered"],
          "minimumReferences": 1,
          "requiredConcepts": [
            { "id": "boundary", "anyOf": ["个人配置", "迁移边界", "默认", "不能"] },
            { "id": "transition", "anyOf": ["旧邮箱", "用户重建", "过渡期", "确认"] }
          ],
          "forbiddenPatterns": ["日程规则通讯录默认全部包含"]
        }
      },
      {
        "id": "QG-PRO-NEGATIVE",
        "kind": "negative",
        "turn": 5,
        "question": "客户要求在合同里承诺任何数据规模都能用高级备份，并保证固定恢复时间，可以直接答应吗？",
        "expected": {
          "scopes": ["professional"],
          "statuses": ["answered", "partially_answered"],
          "minimumReferences": 1,
          "matchTypes": ["exact"],
          "requiredConcepts": [
            { "id": "refusal", "anyOf": ["不能", "不建议", "不可", "需确认"] },
            { "id": "inputs", "anyOf": ["数据规模", "恢复指标", "兼容", "实施责任"] }
          ],
          "forbiddenPatterns": ["可以直接对外承诺恢复时间", "高级备份适用于任意数据规模"]
        }
      }
    ]
  },
  {
    "suiteId": "general_discovery",
    "title": "通用库：需求发现与客户沟通",
    "cases": [
      {
